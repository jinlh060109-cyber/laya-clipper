# AI that reads the transcript and proposes clips (steps 3-4) and fills in
# per-clip details (step 8). Leave all empty to run without AI: clips are then
# cut into fixed sentence-aligned chunks and Laya uses its built-in questions.
#
# Claude (default model claude-opus-5): setting the key alone is enough.
ANTHROPIC_API_KEY=
# Or pick another provider: anthropic | openai | deepseek | kimi | openrouter | ollama | custom
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# Speaker diarization (optional)
HF_TOKEN=
# Force a device for Whisper and Laya: auto | cuda | xpu | mps | cpu
CLIPPER_LAYA_DEVICE=
CLIPPER_LAYA_REPO=
# Where the style prompt is stored (default ./style.json)
CLIPPER_STYLE=
FFMPEG_PATH=
FFPROBE_PATH=
