# AI that reads the transcript and proposes clips (steps 3-4) and fills in
# per-clip details (step 8). Leave all empty to run without AI: clips are then
# cut into fixed sentence-aligned chunks and Laya uses its built-in questions.
#
# The web page's "AI provider" panel writes these for you.
# Claude (default model claude-opus-5): setting the key alone is enough.
ANTHROPIC_API_KEY=
# Or pick another provider (`clipper providers` lists them):
#   anthropic | alibaba_token_plan | alibaba | deepseek | kimi | openrouter |
#   openai | ollama | custom | none (no AI even when a key is set)
AI_PROVIDER=
AI_MODEL=
# Each provider keeps its own key, so switching needs no retyping:
ALIBABA_TOKEN_PLAN_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Key for `custom` (or a fallback for any provider), and its /v1 address
AI_API_KEY=
AI_BASE_URL=

# Speaker diarization (optional)
HF_TOKEN=
# Force a device for Whisper and Laya: auto | cuda | xpu | mps | cpu
CLIPPER_LAYA_DEVICE=
CLIPPER_LAYA_REPO=
# Where the style prompt is stored (default ./style.json)
CLIPPER_STYLE=
FFMPEG_PATH=
FFPROBE_PATH=
